{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cprisk:report-upload:1",
  "title": "ReportUpload HTTP JSON v1 (not ProtoJSON)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "contract_version",
    "app_id",
    "sdk_version",
    "report_id",
    "ts",
    "nonce",
    "session_token",
    "sig_ver",
    "key_id",
    "device_id",
    "scene",
    "payload_json",
    "signature",
    "payload_sha256"
  ],
  "properties": {
    "sig_ver": {
      "type": "string",
      "minLength": 1,
      "x-swift-expression": "sigVer"
    },
    "re_attestation_assertion": {
      "type": "string",
      "x-swift-expression": "reAttestationAssertion?.base64EncodedString()"
    },
    "ts": {
      "type": "integer",
      "minimum": 946684800000,
      "exclusiveMaximum": 4102444800000,
      "x-swift-expression": "ts"
    },
    "trust_level": {
      "type": "string",
      "x-swift-expression": "trustLevel?.rawValue"
    },
    "binding_digest": {
      "type": "string",
      "x-swift-expression": "bindingDigest"
    },
    "attestation_key_id": {
      "type": "string",
      "x-swift-expression": "attestationKeyId"
    },
    "output_path_integrity": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "x-swift-expression": "outputPathIntegrity"
    },
    "nonce": {
      "type": "string",
      "minLength": 1,
      "x-swift-expression": "nonce"
    },
    "session_token": {
      "type": "string",
      "minLength": 1,
      "x-swift-expression": "sessionToken"
    },
    "device_id": {
      "type": "string",
      "minLength": 1,
      "x-swift-expression": "deviceId"
    },
    "scene": {
      "type": "string",
      "minLength": 1,
      "x-swift-expression": "scene"
    },
    "payload_json": {
      "type": "string",
      "minLength": 1,
      "x-swift-expression": "payloadJson.base64EncodedString()"
    },
    "attestation_assertion": {
      "type": "string",
      "x-swift-expression": "attestationAssertion?.base64EncodedString()"
    },
    "app_id": {
      "type": "string",
      "minLength": 1,
      "x-swift-expression": "appId"
    },
    "sdk_version": {
      "type": "string",
      "minLength": 1,
      "x-swift-expression": "sdkVersion"
    },
    "binding_mode": {
      "type": "string",
      "x-swift-expression": "bindingMode"
    },
    "kind": {
      "const": "sdk_report",
      "x-swift-expression": "\"sdk_report\""
    },
    "payload_sha256": {
      "type": "string",
      "minLength": 1,
      "x-swift-expression": "payloadSha256.base64EncodedString()"
    },
    "report_id": {
      "type": "string",
      "minLength": 1,
      "x-swift-expression": "reportId"
    },
    "contract_version": {
      "const": 1,
      "x-swift-expression": "1"
    },
    "key_id": {
      "type": "string",
      "minLength": 1,
      "x-swift-expression": "keyId"
    },
    "signature": {
      "type": "string",
      "minLength": 1,
      "x-swift-expression": "signature"
    },
    "field_mapping_version": {
      "type": "string",
      "x-swift-expression": "fieldMappingVersion"
    }
  }
}
