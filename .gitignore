# Red team analysis notes & SDK spec (local only)
RED_TEAM_ANALYSIS_ROUND*.md
# NOTE: the old pattern `sdk *.txt` (with a literal space) was ambiguous and
# matched almost nothing intentionally. Use explicit no-space patterns below;
# a file whose name literally contains a space must be renamed to match.
sdk-*.txt
sdk_*.txt

# CFF / anti-deobfuscation implementation reports (local tracking)
CFF_IMPLEMENTATION_REPORT.md
ANTI_DEOBFUSCATION_REPORT.md

# CocoaPods podspec (local / private distribution only; not tracked)
CloudPhoneRiskKit.podspec

# Python contract verifier cache
__pycache__/
*.pyc
