static __attribute__((noinline, used)) void cprisk_thread_run_b_i(cprisk_vm_interp_frame_t *fr) {
    /* This frame owns ctx until the entire tail chain returns. */
    cprisk_thread_context_i ctx = { .fr = fr };
    if (cprisk_thread_prepare_b_i(&ctx)) {
        cprisk_thread_fn_i first = cprisk_thread_select_b_i(ctx.logical);
        first(&ctx);
    }
    if (fr->path_lane == 1u) cprisk_vm_interp_finish_run_lane1_i(fr);
    else cprisk_vm_interp_finish_run_lane2_i(fr);
}
