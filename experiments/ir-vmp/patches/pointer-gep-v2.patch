+		Value* AV = ldPR(B, rdPR(B, IP, 1, "vm.icp.a"));
+		Value* BV = ldPR(B, rdPR(B, IP, 2, "vm.icp.b"));
+		Value* Kind = rdByte(B, IP, 3, "vm.icp.k");
+		Value* R = B.CreateSelect(B.CreateICmpEQ(Kind, B.getInt32(1)),
+			B.CreateICmpNE(AV, BV), B.CreateICmpEQ(AV, BV), "vm.icp.c");
+		stVR(B, Dst, B.CreateZExt(R, I32Ty, "vm.icp.r"));
+		nextInsn(B);
