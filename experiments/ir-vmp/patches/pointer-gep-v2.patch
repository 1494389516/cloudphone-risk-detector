+// CPRisk: express supported GEPs as one index times a byte stride.
+// Struct field ordinals are not byte offsets; use the target DataLayout.
+static bool cpriskGEP(GetElementPtrInst* GEP, const DataLayout& DL,
+                      Value*& Index, uint16_t& Stride) {
+    if (!GEP->getType()->isPointerTy() || GEP->getPointerAddressSpace() != 0 ||
+        DL.getIndexSizeInBits(0) != 64 || DL.getPointerSizeInBits(0) != 64)
+        return false;
+    Type* Source = GEP->getSourceElementType();
+    if (!Source->isSized() || DL.getTypeAllocSize(Source).isScalable()) return false;
+    if (GEP->hasAllConstantIndices()) {
+        APInt Offset(64, 0);
+        if (!GEP->accumulateConstantOffset(DL, Offset)) return false;
+        Index = ConstantInt::get(GEP->getContext(), Offset);
+        Stride = 1;
+        return true;
+    }
+    Type* Element = Source;
+    if (GEP->getNumIndices() == 1) {
+        Index = *GEP->idx_begin();
+    } else if (GEP->getNumIndices() == 2 && isa<ArrayType>(Source)) {
+        auto It = GEP->idx_begin();
+        auto* Zero = dyn_cast<ConstantInt>(*It++);
+        if (!Zero || !Zero->isZero()) return false;
+        Index = *It;
+        Element = cast<ArrayType>(Source)->getElementType();
+    } else {
+        return false;
+    }
+    if (!(Index->getType()->isIntegerTy(32) || Index->getType()->isIntegerTy(64)) ||
+        !Element->isSized()) return false;
+    TypeSize Size = DL.getTypeAllocSize(Element);
+    // The VM stride is u16. Never saturate an unrepresentable stride.
+    if (Size.isScalable() || Size.getFixedValue() > 0xFFFFu) return false;
+    Stride = static_cast<uint16_t>(Size.getFixedValue());
+    return true;
+}
